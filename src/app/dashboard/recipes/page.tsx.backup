"use client";

import { useState, useEffect } from 'react';
import { Book, Plus, Edit, Trash2, Search } from 'lucide-react';

// Mock 食譜數據
const mockRecipes = [
  { id: '1', name: '番茄炒蛋', category: '中式', ingredients: ['番茄', '雞蛋', '鹽', '糖'], prepTime: 10, cookTime: 5, difficulty: '簡單' },
  { id: '2', name: '凱撒沙律', category: '西式', ingredients: ['生菜', '麵包丁', '帕馬森芝士', '凱撒醬'], prepTime: 15, cookTime: 0, difficulty: '簡單' },
  { id: '3', name: '紅酒燴牛肉', category: '西式', ingredients: ['牛肉', '紅酒', '洋蔥', '胡蘿蔔', '蘑菇'], prepTime: 30, cookTime: 120, difficulty: '中等' },
  { id: '4', name: '麻婆豆腐', category: '中式', ingredients: ['豆腐', '絞肉', '豆瓣醬', '花椒'], prepTime: 15, cookTime: 15, difficulty: '中等' },
  { id: '5', name: '提拉米蘇', category: '甜品', ingredients: ['手指餅', '馬斯卡彭芝士', '蛋黃', '咖啡', '可可粉'], prepTime: 30, cookTime: 0, difficulty: '困難' },
];

const categories = ['全部', '中式', '西式', '甜品', '飲品'];
const difficulties = ['全部', '簡單', '中等', '困難'];

export default function RecipesPage() {
  const [isDark, setIsDark] = useState(false);
  const [searchTerm, setSearchTerm] = useState('');
  const [selectedCategory, setSelectedCategory] = useState('全部');
  const [selectedDifficulty, setSelectedDifficulty] = useState('全部');

  useEffect(() => {
    const savedTheme = localStorage.getItem('theme');
    const isDarkMode = savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    setIsDark(isDarkMode);
  }, []);

  // 篩選食譜
  const filteredRecipes = mockRecipes.filter(recipe => {
    const matchesSearch = recipe.name.toLowerCase().includes(searchTerm.toLowerCase());
    const matchesCategory = selectedCategory === '全部' || recipe.category === selectedCategory;
    const matchesDifficulty = selectedDifficulty === '全部' || recipe.difficulty === selectedDifficulty;
    return matchesSearch && matchesCategory && matchesDifficulty;
  });

  const getDifficultyColor = (difficulty: string) => {
    switch (difficulty) {
      case '簡單': return { bg: isDark ? '#14532d' : '#dcfce7', color: isDark ? '#4ade80' : '#16a34a' };
      case '中等': return { bg: isDark ? '#78350f' : '#fef3c7', color: isDark ? '#fbbf24' : '#d97706' };
      case '困難': return { bg: isDark ? '#7f1d1d' : '#fee2e2', color: isDark ? '#f87171' : '#dc2626' };
      default: return { bg: '#f3f4f6', color: '#6b7280' };
    }
  };

  return (
    <div style={{ 
      background: isDark ? '#111827' : '#f5f5f5', 
      minHeight: '100vh', 
      padding: '24px',
      transition: 'all 0.3s ease'
    }}>
      {/* Page Header */}
      <div style={{ marginBottom: '24px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
        <div>
          <h1 style={{ fontSize: '24px', fontWeight: 'bold', margin: '0 0 8px 0', color: isDark ? '#f9fafb' : '#1a1a1a', transition: 'color 0.3s ease' }}>
            食譜管理
          </h1>
          <p style={{ margin: 0, color: isDark ? '#9ca3af' : '#757575', fontSize: '14px', transition: 'color 0.3s ease' }}>
            管理餐廳食譜同配方
          </p>
        </div>
        <button style={{
          padding: '12px 24px',
          background: '#2d9e6d',
          border: 'none',
          borderRadius: '12px',
          color: 'white',
          fontWeight: '600',
          fontSize: '14px',
          cursor: 'pointer',
          display: 'flex',
          alignItems: 'center',
          gap: '8px'
        }}>
          <Plus size={20} /> 新增食譜
        </button>
      </div>

      {/* Stats Cards */}
      <div style={{
        display: 'grid',
        gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))',
        gap: '20px',
        marginBottom: '24px'
      }}>
        <div style={{ padding: '20px', background: isDark ? '#1f2937' : '#ffffff', borderRadius: '16px', boxShadow: isDark ? '0 2px 8px rgba(0,0,0,0.3)' : '0 2px 8px rgba(0,0,0,0.08)', transition: 'all 0.3s ease' }}>
          <p style={{ margin: '0 0 8px 0', color: isDark ? '#9ca3af' : '#757575', fontSize: '12px', transition: 'color 0.3s ease' }}>總食譜數</p>
          <p style={{ margin: 0, fontSize: '28px', fontWeight: 'bold', color: isDark ? '#f9fafb' : '#1a1a1a', transition: 'color 0.3s ease' }}>{mockRecipes.length}</p>
        </div>
        <div style={{ padding: '20px', background: isDark ? '#1f2937' : '#ffffff', borderRadius: '16px', boxShadow: isDark ? '0 2px 8px rgba(0,0,0,0.3)' : '0 2px 8px rgba(0,0,0,0.08)', transition: 'all 0.3s ease' }}>
          <p style={{ margin: '0 0 8px 0', color: isDark ? '#9ca3af' : '#757575', fontSize: '12px', transition: 'color 0.3s ease' }}>中式食譜</p>
          <p style={{ margin: 0, fontSize: '28px', fontWeight: 'bold', color: '#2d9e6d' }}>{mockRecipes.filter(r => r.category === '中式').length}</p>
        </div>
        <div style={{ padding: '20px', background: isDark ? '#1f2937' : '#ffffff', borderRadius: '16px', boxShadow: isDark ? '0 2px 8px rgba(0,0,0,0.3)' : '0 2px 8px rgba(0,0,0,0.08)', transition: 'all 0.3s ease' }}>
          <p style={{ margin: '0 0 8px 0', color: isDark ? '#9ca3af' : '#757575', fontSize: '12px', transition: 'color 0.3s ease' }}>西式食譜</p>
          <p style={{ margin: 0, fontSize: '28px', fontWeight: 'bold', color: '#5ac8fa' }}>{mockRecipes.filter(r => r.category === '西式').length}</p>
        </div>
        <div style={{ padding: '20px', background: isDark ? '#1f2937' : '#ffffff', borderRadius: '16px', boxShadow: isDark ? '0 2px 8px rgba(0,0,0,0.3)' : '0 2px 8px rgba(0,0,0,0.08)', transition: 'all 0.3s ease' }}>
          <p style={{ margin: '0 0 8px 0', color: isDark ? '#9ca3af' : '#757575', fontSize: '12px', transition: 'color 0.3s ease' }}>甜品</p>
          <p style={{ margin: 0, fontSize: '28px', fontWeight: 'bold', color: '#ec4899' }}>{mockRecipes.filter(r => r.category === '甜品').length}</p>
        </div>
      </div>

      {/* Search & Filter */}
      <div style={{
        background: isDark ? '#1f2937' : '#ffffff',
        padding: '20px',
        borderRadius: '16px',
        boxShadow: isDark ? '0 2px 8px rgba(0,0,0,0.3)' : '0 2px 8px rgba(0,0,0,0.08)',
        marginBottom: '24px',
        transition: 'all 0.3s ease'
      }}>
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: '16px' }}>
          <div style={{ position: 'relative' }}>
            <Search size={18} color={isDark ? '#9ca3af' : '#757575'} style={{ position: 'absolute', left: '12px', top: '50%', transform: 'translateY(-50%)' }} />
            <input
              type="text"
              placeholder="搜尋食譜..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              style={{
                width: '100%',
                padding: '10px 12px 10px 40px',
                border: '1px solid ' + (isDark ? '#374151' : '#e5e7eb'),
                borderRadius: '12px',
                fontSize: '14px',
                background: isDark ? '#374151' : 'white',
                color: isDark ? '#f9fafb' : '#1a1a1a',
                outline: 'none',
                transition: 'all 0.3s ease'
              }}
            />
          </div>
          <select
            value={selectedCategory}
            onChange={(e) => setSelectedCategory(e.target.value)}
            style={{
              padding: '10px 12px',
              border: '1px solid ' + (isDark ? '#374151' : '#e5e7eb'),
              borderRadius: '12px',
              fontSize: '14px',
              background: isDark ? '#374151' : 'white',
              color: isDark ? '#f9fafb' : '#1a1a1a',
              outline: 'none',
              transition: 'all 0.3s ease'
            }}
          >
            {categories.map(cat => (
              <option key={cat} value={cat}>{cat}</option>
            ))}
          </select>
          <select
            value={selectedDifficulty}
            onChange={(e) => setSelectedDifficulty(e.target.value)}
            style={{
              padding: '10px 12px',
              border: '1px solid ' + (isDark ? '#374151' : '#e5e7eb'),
              borderRadius: '12px',
              fontSize: '14px',
              background: isDark ? '#374151' : 'white',
              color: isDark ? '#f9fafb' : '#1a1a1a',
              outline: 'none',
              transition: 'all 0.3s ease'
            }}
          >
            {difficulties.map(diff => (
              <option key={diff} value={diff}>{diff}</option>
            ))}
          </select>
        </div>
      </div>

      {/* Recipes Grid */}
      <div style={{
        display: 'grid',
        gridTemplateColumns: 'repeat(auto-fill, minmax(300px, 1fr))',
        gap: '20px'
      }}>
        {filteredRecipes.map((recipe) => {
          const diffColor = getDifficultyColor(recipe.difficulty);
          return (
            <div
              key={recipe.id}
              style={{
                background: isDark ? '#1f2937' : '#ffffff',
                borderRadius: '16px',
                boxShadow: isDark ? '0 2px 8px rgba(0,0,0,0.3)' : '0 2px 8px rgba(0,0,0,0.08)',
                padding: '20px',
                transition: 'all 0.3s ease'
              }}
              onMouseOver={(e) => {
                e.currentTarget.style.transform = 'translateY(-2px)';
                e.currentTarget.style.boxShadow = isDark ? '0 4px 12px rgba(0,0,0,0.5)' : '0 4px 12px rgba(0,0,0,0.12)';
              }}
              onMouseOut={(e) => {
                e.currentTarget.style.transform = 'translateY(0)';
                e.currentTarget.style.boxShadow = isDark ? '0 2px 8px rgba(0,0,0,0.3)' : '0 2px 8px rgba(0,0,0,0.08)';
              }}
            >
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: '12px' }}>
                <div>
                  <h3 style={{ fontSize: '18px', fontWeight: '600', margin: '0 0 4px 0', color: isDark ? '#f9fafb' : '#1a1a1a', transition: 'color 0.3s ease' }}>{recipe.name}</h3>
                  <span style={{ fontSize: '12px', color: isDark ? '#9ca3af' : '#757575', transition: 'color 0.3s ease' }}>{recipe.category}</span>
                </div>
                <span style={{
                  padding: '4px 12px',
                  background: diffColor.bg,
                  color: diffColor.color,
                  borderRadius: '20px',
                  fontSize: '12px',
                  fontWeight: '600'
                }}>
                  {recipe.difficulty}
                </span>
              </div>

              <div style={{ display: 'flex', gap: '16px', marginBottom: '12px' }}>
                <div>
                  <p style={{ margin: '0 0 4px 0', fontSize: '12px', color: isDark ? '#9ca3af' : '#757575', transition: 'color 0.3s ease' }}>準備時間</p>
                  <p style={{ margin: 0, fontSize: '14px', fontWeight: '600', color: isDark ? '#f9fafb' : '#1a1a1a', transition: 'color 0.3s ease' }}>{recipe.prepTime} 分鐘</p>
                </div>
                <div>
                  <p style={{ margin: '0 0 4px 0', fontSize: '12px', color: isDark ? '#9ca3af' : '#757575', transition: 'color 0.3s ease' }}>烹飪時間</p>
                  <p style={{ margin: 0, fontSize: '14px', fontWeight: '600', color: isDark ? '#f9fafb' : '#1a1a1a', transition: 'color 0.3s ease' }}>{recipe.cookTime} 分鐘</p>
                </div>
              </div>

              <div style={{ marginBottom: '16px' }}>
                <p style={{ margin: '0 0 8px 0', fontSize: '12px', color: isDark ? '#9ca3af' : '#757575', transition: 'color 0.3s ease' }}>食材</p>
                <div style={{ display: 'flex', flexWrap: 'wrap', gap: '6px' }}>
                  {recipe.ingredients.map((ing, idx) => (
                    <span key={idx} style={{
                      padding: '4px 8px',
                      background: isDark ? '#374151' : '#f5f5f5',
                      borderRadius: '6px',
                      fontSize: '12px',
                      color: isDark ? '#9ca3af' : '#757575',
                      transition: 'all 0.3s ease'
                    }}>
                      {ing}
                    </span>
                  ))}
                </div>
              </div>

              <div style={{ display: 'flex', gap: '8px' }}>
                <button style={{
                  flex: 1,
                  padding: '8px',
                  background: isDark ? '#374151' : '#f5f5f5',
                  border: 'none',
                  borderRadius: '8px',
                  color: isDark ? '#9ca3af' : '#757575',
                  cursor: 'pointer',
                  fontSize: '13px',
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                  gap: '4px',
                  transition: 'all 0.3s ease'
                }}>
                  <Edit size={14} /> 編輯
                </button>
                <button style={{
                  padding: '8px',
                  background: isDark ? '#450a0a' : '#fef2f2',
                  border: 'none',
                  borderRadius: '8px',
                  color: '#ef4444',
                  cursor: 'pointer',
                  fontSize: '13px',
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                  gap: '4px',
                  transition: 'all 0.3s ease'
                }}>
                  <Trash2 size={14} /> 刪除
                </button>
              </div>
            </div>
          );
        })}
      </div>

      {filteredRecipes.length === 0 && (
        <div style={{
          textAlign: 'center',
          padding: '60px 20px',
          color: isDark ? '#9ca3af' : '#757575',
          transition: 'color 0.3s ease'
        }}>
          <Book size={48} color={isDark ? '#4b5563' : '#d1d5db'} style={{ marginBottom: '16px' }} />
          <p style={{ fontSize: '16px' }}>找不到符合條件的食譜</p>
        </div>
      )}
    </div>
  );
}